{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vividarium",
  "version": "../package.json",
  "identifier": "io.github.baoyunfan0101.vividarium",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vividarium",
        "width": 1040,
        "height": 680,
        "minWidth": 760,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' vividarium: http://vividarium.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost https:; font-src 'self' data:; worker-src 'self' blob:",
      "capabilities": ["desktop"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Photography",
    "shortDescription": "Local biological photo library workbench",
    "longDescription": "Index, browse, map, classify, and maintain local biological photo libraries and taxonomy."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/baoyunfan0101/Vividarium/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJCRjVBODZEMkREODM0RTcKUldUbk5OZ3RiYWoxdXgweFk0SHkwWllZb2xqVzRBejZIWEFUY0V5emF2NDBONzIxbDFOR0k1alQK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
